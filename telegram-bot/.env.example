# Copy to .env and fill in real values locally. Never commit .env.

TELEGRAM_BOT_TOKEN=
# Same secret configured as BOT_SERVICE_TOKEN on the backend.
BOT_SERVICE_TOKEN=

# The backend API base URL (no trailing slash), e.g. https://api.yourdomain.com
BACKEND_API_BASE_URL=http://localhost:8000

# Public HTTPS URLs of the two Mini Apps (Telegram requires HTTPS in
# production; for local dev, use a tunnel like ngrok/cloudflared).
USER_MINI_APP_URL=https://user.yourdomain.com
ADMIN_MINI_APP_URL=https://admin.yourdomain.com

LOG_LEVEL=INFO
