# ============================================================
# Backend Environment Configuration Template
# Copy this file to `secrets/backend.env` and fill in real values.
# NEVER commit `secrets/backend.env` to version control.
# ============================================================

ENVIRONMENT=production
# Options: development | staging | production

# --- Supabase / PostgreSQL Database -------------------------------------
# Async SQLAlchemy requires `postgresql+asyncpg://`
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?prepared_statement_cache_size=0

# Supabase REST / Storage (optional, only if called directly)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Telegram Bot --------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# Shared secret between FastAPI backend and Telegram Bot process
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_SERVICE_TOKEN=generate-a-strong-random-32-char-token

# --- Security ------------------------------------------------------------
JWT_SECRET=generate-a-long-random-secret-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS Allowed Origins ------------------------------------------------
# Comma-separated domains allowed to communicate with this backend API
CORS_ALLOWED_ORIGINS=https://user.yourdomain.com,https://admin.yourdomain.com

# --- Logging & Pagination ------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
