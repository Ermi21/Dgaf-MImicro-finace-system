# ============================================================
# Telegram Bot Environment Configuration Template
# Copy this file to `secrets/telegram-bot.env` and fill in real values.
# NEVER commit `secrets/telegram-bot.env` to version control.
# ============================================================

TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Must match BOT_SERVICE_TOKEN in backend.env
BOT_SERVICE_TOKEN=generate-a-strong-random-32-char-token

# Internal or public base URL of the backend FastAPI service
BACKEND_API_BASE_URL=http://backend:8000

# Public HTTPS URLs of the two Mini Apps (Telegram requires HTTPS)
USER_MINI_APP_URL=https://user.yourdomain.com
ADMIN_MINI_APP_URL=https://admin.yourdomain.com

LOG_LEVEL=INFO
