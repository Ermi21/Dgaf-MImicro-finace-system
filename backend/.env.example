# ============================================================
# Copy this file to `.env` and fill in REAL values locally.
# NEVER commit `.env`. NEVER paste real secrets into chat,
# issues, logs, or the frontend/mini apps.
# ============================================================

ENVIRONMENT=development
# development | staging | production

# --- Supabase / PostgreSQL ---------------------------------------------
# Use the Supabase "Session pooler" or direct connection string.
# SQLAlchemy async needs the `postgresql+asyncpg://` scheme.
DATABASE_URL=postgresql+asyncpg://postgres.vgquhttvlrvvwpilawho:y8U3'w%5EPhR%2CpnVZ@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres  

# Only needed if you call the Supabase REST/Storage API directly
# (the backend normally talks to Postgres directly via DATABASE_URL).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8255660064:AAEpVFQQxnU6auqmIY506o2iUBCU9lRw7BM
# Max age (seconds) a Telegram WebApp initData payload is considered valid
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# Shared secret between this API and the telegram-bot process ONLY.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_SERVICE_TOKEN=

# --- Security --------------------------------------------------------------
# Used only for internal service-to-service signing (NOT Telegram auth).
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins (Mini App domains).
CORS_ALLOWED_ORIGINS=https://user-mini-app.example.com,https://admin-mini-app.example.com

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Pagination defaults -------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
